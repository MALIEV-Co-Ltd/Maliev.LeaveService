# .NET Gitignore - Comprehensive
# Based on https://github.com/github/gitignore/blob/main/Dotnet.gitignore
# Plus additional IDE and project-specific entries

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
msbuild.log
msbuild.err
msbuild.wrn

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg
packages/
!**/packages/build/
nuget.exe
_._

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/
*.user
*.csproj.user
*.userosscache
*.sln.docstates
*.rsuser
*.aps

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Test result files
*test_results*.txt
*_test_*.txt
*.log
*.trx
coverage/
*.coverage
*.coveragexml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
Desktop.ini

# VS storage options
*.vcxproj.user

# Local configuration files (secrets)
appsettings.*.json
!appsettings.json
!appsettings.Development.json
!appsettings.Local.json
appsettings.*.local.json
*.local.json

# .NET SDK
.dotnet/
dotnet-tools.json
global.json

# NuGet
*.nuget.props
*.nuget.targets

# Optional NuGet cache
.nuget/

# MacOS
.DS_Store
._*

# Linux
*~

# kcov coverage
*.gcov
*.gcda
*.gcno

# Coverlet
coverage.json
coverage.*.xml

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# AB comparison
results/

# Rider
.idea/

# Sandboxed build/CLI home directories generated by scripted dotnet invocations
.dotnet-test-output/
.dotnet-cli-home*/
